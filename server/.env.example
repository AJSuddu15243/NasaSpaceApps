# Postgres connection string (matches server/docker-compose.yml defaults).
DATABASE_URL=postgres://lunar:lunar@localhost:5432/lunar_window

# Solgaleo (POST /api/ask). Explicit server-only configuration; no token fallback.
# Copy this file to .env locally (ignored). Never prefix these names with VITE_.
ASK_API_KEY=
ASK_BASE_URL=https://api.groq.com/openai/v1/chat/completions
ASK_MODEL=openai/gpt-oss-120b
