# Postgres connection string (matches server/docker-compose.yml defaults).
DATABASE_URL=postgres://lunar:lunar@localhost:5432/lunar_window

# Ask AI assistant (POST /api/ask). Any OpenAI-compatible provider works.
# Free options (no card required):
#   Groq:      ASK_API_KEY=gsk_...  ASK_BASE_URL=https://api.groq.com/openai/v1/chat/completions  ASK_MODEL=openai/gpt-oss-120b
#   Gemini:    ASK_API_KEY=AIza...  ASK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  ASK_MODEL=gemini-2.0-flash
#   GitHub Models (PAT, not the gh OAuth token): GITHUB_TOKEN=github_pat_...
ASK_API_KEY=
ASK_BASE_URL=
ASK_MODEL=
